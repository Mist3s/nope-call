<?xml version="1.0" encoding="utf-8"?>
<!--
    Модуль :app — роль bridge (архитектура §2): здесь MainActivity, регистрация Pigeon
    и всё, что знает про Flutter. Сервис проверки звонков, приёмники и разрешения
    горячего пути объявлены в манифесте :core и приезжают слиянием.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:name="com.mist3s.nopecall.core.NopeCallApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false">

        <!--
            allowBackup=false и dataExtractionRules — не перестраховка: сырой журнал звонков
            и логи режима наблюдения не должны уезжать в облако мимо остальных гарантий
            приватности (ТЗ §11.4, §7.7.4). Перенос правил делается явным экспортом в JSON.

            usesCleartextTraffic=false — сеть есть только у апдейтера и только к GitHub
            по TLS (ТЗ §15.6).

            ПРО СПИСОК РАЗРЕШЕНИЙ. В объединённом манифесте видны INTERNET
            и REQUEST_INSTALL_PACKAGES — оба приходят из модуля :updater и нужны ровно
            для одного: проверить latest.json и скачать APK нового выпуска (ТЗ §15.5).
            К проверке звонков, журналу и логам наблюдения они отношения не имеют:
            у модуля :updater нет зависимости ни на :core, ни на Room, и это проверяется
            задачей сборки verifyUpdaterBoundaries, а не обещанием в документации.
            Поэтому интерфейс говорит «сеть используется только для обновления»,
            а не «сети нет» — второе было бы неправдой при таком списке разрешений.
        -->

        <activity
            android:name="com.mist3s.nopecall.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Отдача архива логов наружу (ТЗ §7.7.3 п. 4). Только через FileProvider: прямой
            file:// Android не пропустит, а копировать архив в общее хранилище значило бы
            оставить сырой журнал звонков там, откуда его никто не удалит.

            grantUriPermissions даёт доступ ровно к отданному файлу и ровно тому приложению,
            которое пользователь выбрал.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            Исход установки обновления от PackageInstaller (ТЗ §15.5).

            Без этого приёмника обновление выглядело как «ничего не произошло»: система
            присылает STATUS_PENDING_USER_ACTION вместе с интентом диалога подтверждения
            в широковещательном сообщении, получателя не было — диалог не показывался,
            а установщик честно отвечал «начато», и интерфейс возвращал кнопку «Обновить».

            exported=false: сообщение приходит через PendingIntent, то есть от имени самого
            приложения, и снаружи этот приёмник не нужен никому.
        -->
        <receiver
            android:name="com.mist3s.nopecall.InstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mist3s.nopecall.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Нужна инструменту Flutter для генерации GeneratedPluginRegistrant -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- Звонок из карточки: ACTION_DIAL, без разрешения CALL_PHONE (ТЗ §10) -->
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
    </queries>
</manifest>
