# Обёртка Gradle (gradlew, gradlew.bat, gradle-wrapper.jar) СОЗНАТЕЛЬНО отслеживается,
# хотя шаблон Flutter её игнорирует. Без неё в CI нечем запустить ./gradlew, а версия
# Gradle перестаёт быть зафиксированной. Плюс gradle/actions проверяет контрольную
# сумму gradle-wrapper.jar — это защита от подмены обёртки.
/.gradle
/captures/
# local.properties машинный: пути к Flutter SDK и Android SDK у каждого свои.
# settings.gradle.kts умеет обходиться без него, читая FLUTTER_ROOT.
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks
